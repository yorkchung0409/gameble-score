# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
NODE_ENV=production

# MySQL 数据库连接（微信云托管会自动提供 MYSQL_ADDRESS、MYSQL_USERNAME、MYSQL_PASSWORD）
# 云托管只需额外设置 DB_NAME；本地或其他平台请设置下面全部 DB_* 变量。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gameble
DB_PASSWORD=
DB_NAME=gameble_score

# 前端配置
CLIENT_BASE_PATH=/

# 仅在公网 wx.login 回退模式下需要。微信云托管私有调用会注入 OpenID，无需配置。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
